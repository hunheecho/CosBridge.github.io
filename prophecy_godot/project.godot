; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="예언의 시간표 — Godot 첫 전투"
config/version="0.5.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/game/game.gd"
Audio="*res://scripts/game/audio.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=640
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[editor]

; 실제 속도 영상(Movie Maker) 기록 설정. 게임 규칙과 무관하며 --write-movie 로 찍을 때만 쓰인다.
; mjpeg_quality는 4.7.2에서 결과 크기를 바꾸지 않는 것으로 측정됐다(0.35와 0.05가 바이트까지 같은 파일).
; 그래서 용량은 길이로만 조절한다 — 클립을 짧게 찍는다(docs/captures/0.8.0_clips/README.md).
movie_writer/mjpeg_quality=0.35
movie_writer/movie_file=""
movie_writer/disable_vsync=true
movie_writer/fps=24

[gui]

; 화면 기본 글꼴(한글). 이 값이 엔진 시작 때 기본 테마의 글꼴과 ThemeDB.fallback_font를 함께 채운다.
; 웹 빌드에는 운영체제 글꼴이 없어 이것이 없으면 한글이 전부 네모(□)로 나온다 — docs/WEB_BUILD.md §2.
; 파일과 라이선스: assets/fonts/ui.ttf · assets/fonts/OFL.txt · docs/FONT_LICENSE.md
theme/custom_font="res://assets/fonts/ui.ttf"

