{
  "schema": "prophecy_suites/1",
  "note": "테스트 스위트 실행 명세(손으로 작성). tools/run_suites.py가 읽는 유일한 정본이다. 스위트마다 '필수 환경 설정'과 '제한 시간'을 여기서 관리하고, 실행기는 빠진 설정이 있으면 실행하지 않고 즉시 실패로 끝낸다(2026-09-08 고아 루프 재발 방지).",
  "defaults": {
    "timeout_sec": 900,
    "isolate_userdata": true,
    "isolate_note": "모든 실행은 APPDATA/LOCALAPPDATA를 실행 전용 폴더로 격리한다. 사용자 실제 저장·프로필을 건드리지 않고, 이전 실행이 남긴 프로필 때문에 결과가 달라지는 것도 막는다."
  },
  "verdict_rules": {
    "note": "종료 코드 0만으로 통과로 보지 않는다. 아래를 모두 만족해야 pass다.",
    "require_exit_zero": true,
    "require_summary_line": true,
    "summary_patterns": [
      "(?P<pass>\\d+)/(?P<total>\\d+) PASS",
      "(?P<pass>\\d+)/(?P<total>\\d+) 통과"
    ],
    "require_zero_fail_lines": true,
    "fail_line_pattern": "^FAIL ",
    "forbid_patterns": [
      "SCRIPT ERROR",
      "Parse Error",
      "Compile Error"
    ],
    "forbid_note": "GDScript 오류가 있으면 요약이 남아 있어도 실패다. 오류로 _init이 중단되면 quit()에 도달하지 못해 프로세스가 영원히 남는 사례가 있었다."
  },
  "suites": {
    "run_tests": {
      "env": {},
      "timeout_sec": 600,
      "desc": "전투 규칙 회귀(기준 전투 포함)"
    },
    "port_tests": {
      "env": {},
      "timeout_sec": 600,
      "desc": "HTML 이식 대조"
    },
    "boss_tests": {
