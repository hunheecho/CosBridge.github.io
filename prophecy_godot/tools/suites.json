  "runner": {
    "note": "tools/run_suites.py 사용법 요약(정본은 그 파일의 머리말).",
    "commands": [
      "python tools/run_suites.py --group all --jobs 2",
      "python tools/run_suites.py --suites balance_tests,hud_tests",
      "python tools/run_suites.py --self-test"
    ],
    "exit_codes": {
      "0": "전부 pass",
      "1": "실패(FAIL·스크립트 오류·요약 없음)",
      "2": "시간초과(자동 진행의 정체·미도달은 스위트 실패로 집계)",
      "3": "설정 오류(환경 충돌·중복 실행·명세 밖 스위트)",
      "130": "사용자 중단(aborted)"
    },
    "records": "실행마다 <run_dir>/summary.md·summary.json, 스위트마다 고유 로그, 취소 시 ABORTED.md, 인계 시 HANDOVER.txt"
  }
}