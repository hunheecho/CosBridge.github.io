    "run_layer_tests": {
      "env": {
        "PROPHECY_LEGACY_PLACES": "1"
      },
      "timeout_sec": 900,
      "desc": "회차 계층(옛 지역 일정 전용)",
      "env_reason": "테마 장소가 아니라 기존 지역(forest·ridge…) 일정으로 검사한다. 이 값이 없으면 편성·카드 검사가 어긋나고 GDScript 오류로 중단된다."
    },
    "world_tests": {
      "env": {
        "PROPHECY_LEGACY_PLACES": "1"
      },
      "timeout_sec": 900,
      "desc": "세계 변화·등급(옛 지역 일정 전용)",
      "env_reason": "위와 같음. 2026-09-08 고아 루프는 이 값을 빼고 돌려 29/31로 실패했고, 값을 넣으면 33/33이다."
    },
    "content_tests": {
      "env": {
        "PROPHECY_LEGACY_PLACES": "1"
      },
      "timeout_sec": 900,
      "desc": "반복 콘텐츠·회차 특징(옛 지역 일정 전용)",
      "env_reason": "위와 같음. 값이 없으면 109행에서 `Invalid access to property or key 'id'`로 중단되고 프로세스가 스스로 끝나지 못한다."
    },
    "ui_flow_tests": {
      "env": {
        "PROPHECY_LEGACY_PLACES": "1"
      },
      "timeout_sec": 900,
      "desc": "실제 장면 화면 흐름(옛 지역 일정 전용)",
      "env_reason": "위와 같음."
    },
    "ui_smoke_short": {
      "kind": "scene",
      "args": [],
      "out_dir_env": "PROPHECY_UI_SMOKE",
      "env": {
        "PROPHECY_UI_SPEED": "5",
        "PROPHECY_UI_MAXMIN": "25",
        "PROPHECY_UI_STALL": "180"
      },
      "timeout_sec": 1800,
      "desc": "화면 순회 자동 진행(거점·전투·저장/계속하기까지). 완주 검증이 아니다",
      "env_reason": "속도·상한·정체 판정을 실행기가 고정한다. 상한이 없으면 오류로 멈춘 실행이 그대로 남는다.",
      "verdict": {
        "success_pattern": "UI_SMOKE result=done ",
        "summary_patterns": [],
        "forbid_patterns": [
          "SCRIPT ERROR",
          "Parse Error",
          "Compile Error",
          "UI_SMOKE result=(timeout|stalled|incomplete)"
        ],
        "note": "자동 진행은 'N/N PASS' 요약이 없다. 요구한 마지막 단계까지 도달했을 때만 나오는 'UI_SMOKE result=done'과 종료 코드 0을 함께 본다. 시간 초과(2)·정체(3)·미도달(4)은 실패다."
      }
    },
    "ui_smoke_full": {
      "kind": "scene",
      "args": [],
      "out_dir_env": "PROPHECY_UI_SMOKE",
      "env": {
        "PROPHECY_UI_FULL": "1",
        "PROPHECY_UI_SPEED": "6",
        "PROPHECY_UI_ROUTE": "act1_hunt_forest,act2_crimson_ritual,act3_temporal_abyss",
        "PROPHECY_UI_MAXMIN": "90",
        "PROPHECY_UI_STALL": "300"
      },
      "timeout_sec": 5700,
      "desc": "전체 회차 자동 진행(관문 3 → 10일차 회차 결과 → 저장/계속하기)",
      "env_reason": "경로를 고정해 같은 조건에서 재현한다. 상한·정체 판정이 없으면 중단이 완료처럼 보인다.",
      "verdict": {
        "success_pattern": "UI_SMOKE result=done ",
        "summary_patterns": [],
        "forbid_patterns": [
          "SCRIPT ERROR",
          "Parse Error",
          "Compile Error",
          "UI_SMOKE result=(timeout|stalled|incomplete)"
        ],
        "note": "자동 진행은 'N/N PASS' 요약이 없다. 요구한 마지막 단계까지 도달했을 때만 나오는 'UI_SMOKE result=done'과 종료 코드 0을 함께 본다. 시간 초과(2)·정체(3)·미도달(4)은 실패다."
      }
    },
